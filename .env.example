# Copy to .env (git-ignored). The Makefile exports these for Python, dbt and Streamlit.

# dev | prod | demo. "demo" only ever holds synthetic data and never calls the source APIs.
APP_ENV=dev

# PostgreSQL (standard libpq variables, read by psycopg and by dbt/profiles.yml).
# Use a different database (ideally a different Neon project) per environment.
PGHOST=localhost
PGPORT=5432
PGDATABASE=invest_intel
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=prefer            # "require" on Neon

# Indexa Capital
INDEXA_API_TOKEN=

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_INSTRUMENTS_TABLE=instruments
AIRTABLE_TRANSACTIONS_TABLE=transactions

# EODHD (free tier: 20 calls/day, about one year of history)
EODHD_API_TOKEN=
EODHD_DAILY_CALL_BUDGET=18
EODHD_HISTORY_DAYS=365

# AI assistant
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5     # claude-haiku-5-5 is the low-cost option
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_QUESTIONS_PER_SESSION=15
# For apps open to anyone (the demo): a code required to use the assistant, and a cap on
# questions per day across all visitors. Empty means off.
ASSISTANT_ACCESS_CODE=
ASSISTANT_DAILY_LIMIT=

# Streamlit login allowlist (comma separated). Empty means nobody gets in.
ALLOWED_EMAILS=
